---
// "Book Your Appointment for Better Health" block on the blog index.
---
<section class="relative bg-gradient-to-br from-cyan-500 to-cyan-600 overflow-hidden">
       
<div class="w-full bg-[#FFF7F1] py-16 max-[768px]:!py-[30px] px-6 md:px-12 font-sans">

  <div class="max-w-[1360px] mx-auto flex md:flex-row flex-col justify-between items-center gap-12">

    <!-- LEFT SIDE -->
    <div class="w-full ">
      <h2 class="md:text-[48px] text-3xl leading-tight font-extrabold text-[#000] mb-4">
        Book Your 
        Appointment <br> for 
        Better Health
      </h2>

      <!-- CONTACT BLOCK -->
      <div class="space-y-6 text-[#072B21]">

        <!-- Phone -->
        <div class="flex items-center gap-4">
           <div class="w-10 h-10 bg-[#00AEE0] rounded-full flex items-center justify-center text-white">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M17.5 13.6833V16.63C17.5001 16.841 17.4202 17.0441 17.2763 17.1985C17.1325 17.3528 16.9355 17.4469 16.725 17.4617C16.3611 17.4872 16.0639 17.5 15.8333 17.5C8.46917 17.5 2.5 11.5308 2.5 4.16667C2.5 3.93667 2.51278 3.63944 2.53833 3.275C2.5531 3.06454 2.64715 2.86751 2.8015 2.72367C2.95585 2.57984 3.15902 2.4999 3.37 2.5H6.31667C6.42003 2.4999 6.51975 2.53822 6.59644 2.60752C6.67313 2.67682 6.72133 2.77215 6.73167 2.875C6.75056 3.06611 6.76833 3.21944 6.785 3.335C6.9506 4.49077 7.28999 5.61487 7.79167 6.66917C7.87083 6.83583 7.81917 7.035 7.66917 7.14167L5.87083 8.42667C6.97059 10.9886 9.01227 13.0302 11.5742 14.13L12.8575 12.335C12.9097 12.2614 12.9863 12.2086 13.0736 12.1859C13.161 12.1632 13.2535 12.172 13.335 12.2108C14.3892 12.7116 15.513 13.0501 16.6683 13.215C16.7839 13.2317 16.9367 13.2494 17.1267 13.2683C17.2294 13.2789 17.3245 13.3271 17.3936 13.4038C17.4628 13.4805 17.5001 13.5801 17.5 13.6833Z" fill="white"/>
</svg>
</div>
          <a href="tel:08065903131" class="underline">08065903131</a>
        </div>

        <!-- Timing -->
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-[#00AEE0] rounded-full flex items-center justify-center text-white">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M10.0003 1.6665C14.6028 1.6665 18.3337 5.39734 18.3337 9.99984C18.3337 14.6023 14.6028 18.3332 10.0003 18.3332C5.39783 18.3332 1.66699 14.6023 1.66699 9.99984C1.66699 5.39734 5.39783 1.6665 10.0003 1.6665ZM10.0003 4.99984C9.77931 4.99984 9.56735 5.08763 9.41107 5.24392C9.25479 5.4002 9.16699 5.61216 9.16699 5.83317V9.99984C9.16704 10.2208 9.25487 10.4328 9.41116 10.589L11.9112 13.089C12.0683 13.2408 12.2788 13.3248 12.4973 13.3229C12.7158 13.321 12.9248 13.2334 13.0793 13.0789C13.2338 12.9243 13.3215 12.7153 13.3234 12.4968C13.3253 12.2783 13.2413 12.0678 13.0895 11.9107L10.8337 9.65484V5.83317C10.8337 5.61216 10.7459 5.4002 10.5896 5.24392C10.4333 5.08763 10.2213 4.99984 10.0003 4.99984Z" fill="white"/>
</svg>
</div>
          <p>We Are Open in Weekends Also</p>
        </div>
		  
		  		<!-- Map -->
                <div class="md:w-[600px] md:h-[370px] w-[100%] h-[100%] overflow-hidden rounded-lg shadow mt-6">
                    <iframe class="[border:0]" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3887.553919449072!2d77.5494195!3d13.000358499999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae17281badc1b7%3A0xe032b073c3c8070d!2sPraanaVaidya%20Ayurvedic%20Hospital%20-%20Rajajinagar!5e0!3m2!1sen!2sin!4v1765176740797!5m2!1sen!2sin" width="600" height="450" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>

      </div>
    </div>

    <!-- RIGHT SIDE FORM -->
    <div class=" w-full">
      <div class="bg-white md:p-10 p-6 pt-8 rounded-[22px] shadow-xl">

        <form class="space-y-6">

          <!-- Name -->
          <div>
            <label class="block mb-1 font-medium text-sm">Full Name</label>
            <input type="text"
              class="w-full border border-[#E5E5E5] rounded-full px-5 py-3 text-sm focus:outline-none"
              placeholder="Enter your full name">
          </div>

          <!-- Email -->
          <div>
            <label class="block mb-1 font-medium text-sm">Email</label>
            <input type="email"
              class="w-full border border-[#E5E5E5] rounded-full px-5 py-3 text-sm focus:outline-none"
              placeholder="Enter your email address">
          </div>

          <!-- Phone -->
          <div>
            <label class="block mb-1 font-medium text-sm">Phone Number</label>
            <input type="text"
              class="w-full border border-[#E5E5E5] rounded-full px-5 py-3 text-sm focus:outline-none"
              placeholder="Enter your phone number">
          </div>

          <!-- Message -->
          <div>
            <label class="block mb-1 font-medium text-sm">Message</label>
            <textarea
              class="w-full border border-[#E5E5E5] rounded-2xl px-5 py-3 text-sm h-[120px] resize-none focus:outline-none"
              placeholder="Briefly describe your concern"></textarea>
          </div>

          <!-- Checkbox -->
          <div class="flex items-start gap-2 text-sm">
            <input type="checkbox" class="mt-1 w-4 h-4">
            <p>
              I agree to the <a class="text-[#0097C4] underline">Privacy Policy</a> and
              <a class="text-[#0097C4] underline">Terms of Service</a>
            </p>
          </div>

          <!-- Button -->
          <button
            class="w-full py-4 rounded-full text-white font-semibold text-[16px] bg-gradient-to-b from-[#5AD6FF] to-[#0595C4] shadow-lg">
            Book an Appointment
          </button>

        </form>

      </div>
    </div>

  </div>

</div>

    </section>
