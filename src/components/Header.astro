<script is:inline>
(() => {
  // ===== Desktop hover dropdowns (only on real desktop pointers) =====
  const canHover = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  const toggles = document.querySelectorAll('.nav-toggle');
  const menus = {
    treatments: document.getElementById('menu-treatments'),
    doctors: document.getElementById('menu-doctors'),
    resources: document.getElementById('menu-resources'),
  };

  function closeAllDesktopMenus() {
    Object.values(menus).forEach((el) => el && el.classList.remove('pv-open'));
    toggles.forEach((btn) => btn.classList.remove('pv-active'));
  }

  function openMenu(key, btn) {
    const menu = menus[key];
    if (!menu) return;

    // Close others
    Object.entries(menus).forEach(([k, el]) => {
      if (!el) return;
      if (k !== key) el.classList.remove('pv-open');
    });
    toggles.forEach((b) => {
      if (b !== btn) b.classList.remove('pv-active');
    });

    menu.classList.add('pv-open');
    btn && btn.classList.add('pv-active');

    // Position dropdown menus under the button (doctors/resources)
    if (menu.classList.contains('dropdown-menu') && btn) {
      const rect = btn.getBoundingClientRect();
      menu.style.top = (rect.bottom + window.scrollY + 8) + 'px';
      menu.style.left = (rect.left + window.scrollX) + 'px';
    }
  }

  // Desktop behavior:
  // - If canHover: open on hover, close when mouse leaves menu area
  // - If not canHover (touch devices): keep click toggle
  if (canHover) {
    // Small delay prevents flicker when moving between button and menu
    let closeTimer = null;

    function scheduleClose() {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => closeAllDesktopMenus(), 120);
    }
    function cancelClose() {
      clearTimeout(closeTimer);
    }

    toggles.forEach((btn) => {
      const key = btn.getAttribute('data-menu');

      btn.addEventListener('mouseenter', () => {
        cancelClose();
        openMenu(key, btn);
      });

      // Optional: keyboard accessibility
      btn.addEventListener('focus', () => openMenu(key, btn));
    });

    // Keep open while hovering inside the opened menus
    Object.values(menus).forEach((menu) => {
      if (!menu) return;
      menu.addEventListener('mouseenter', cancelClose);
      menu.addEventListener('mouseleave', scheduleClose);
    });

    // Close when leaving the whole header area
    const header = document.querySelector('header');
    header && header.addEventListener('mouseleave', scheduleClose);

    // Close on outside click (still useful)
    document.addEventListener('click', (e) => {
      const insideToggle = e.target.closest('.nav-toggle');
      const insideMenu = e.target.closest('#menu-treatments, #menu-doctors, #menu-resources');
      if (!insideToggle && !insideMenu) closeAllDesktopMenus();
    });
  } else {
    // Touch / no-hover devices: click toggle
    toggles.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const key = btn.getAttribute('data-menu');
        const menu = menus[key];
        if (!menu) return;

        const isOpen = menu.classList.contains('pv-open');
        closeAllDesktopMenus();
        if (!isOpen) openMenu(key, btn);
      });
    });

    document.addEventListener('click', (e) => {
      const insideToggle = e.target.closest('.nav-toggle');
      const insideMenu = e.target.closest('#menu-treatments, #menu-doctors, #menu-resources');
      if (!insideToggle && !insideMenu) closeAllDesktopMenus();
    });
  }

  // ===== Mobile drawer (unchanged) =====
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');

  function toggleMobileDrawer() {
    if (!mobileMenu) return;
    mobileMenu.classList.toggle('pv-open');
  }
  mobileBtn && mobileBtn.addEventListener('click', toggleMobileDrawer);

  // ===== Mobile accordions (unchanged) =====
  document.querySelectorAll('.mobile-nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-mobile-menu');
      const panel = document.getElementById('mobile-menu-' + key);
      if (!panel) return;
      panel.classList.toggle('pv-open');
    });
  });
})();
</script>
