---
// Floating "Our Locations / Contact Us" sticky CTA.
---
<div class="fixed bottom-4 left-1/2 z-[9999] flex max-w-[95%] -translate-x-1/2 items-center gap-[6px] rounded-[240px] bg-white p-[6px] shadow-[0_8px_24px_rgba(0,0,0,0.12)] [transition:all_0.3s_ease] max-[480px]:w-[95%] md:hidden [&.expanded]:min-h-[200px] [&.expanded]:w-[95%] [&.expanded]:max-w-[500px] [&.expanded]:flex-col [&.expanded]:rounded-[20px] [&.expanded]:p-5" id="stickyCta">
    <!-- Initial Buttons -->
    <div class="flex w-full gap-[6px] max-[480px]:justify-between md:hidden [.expanded_&]:!hidden">
      <button class="w-1/2 whitespace-nowrap rounded-full border-none px-[22px] py-[14px] text-[15px] font-medium no-underline cursor-pointer [transition:background_0.2s] hover:bg-[#f5f5f5] bg-[#f7f7f7] text-[#111]" id="locationsToggle" type="button">
        Our Locations
      </button>
      <button class="w-1/2 whitespace-nowrap rounded-full border-none px-[22px] py-[14px] text-[15px] font-medium no-underline cursor-pointer [transition:background_0.2s] hover:bg-[#f5f5f5] bg-brand text-white" id="contactToggle" type="button">
        Contact Us
      </button>
    </div>
    
    <!-- Expanded Content - Locations -->
    <div class="hidden w-full" id="locationsContent">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-[16px] font-semibold text-[#111]">Choose Your Location</span>
        <button class="flex h-8 w-8 items-center justify-center rounded-full border-none bg-[#f5f5f5] text-[20px] text-[#666] cursor-pointer [transition:background_0.2s] hover:bg-[#e5e5e5]" id="closeLocations" type="button">×</button>
      </div>
      <div class="grid grid-cols-2 gap-2 max-[480px]:grid-cols-1" id="locationsGrid">
        <a href="https://maps.app.goo.gl/9aogSEqiEDBjSeVK7" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Jayanagar</a>
		<a href="https://maps.app.goo.gl/3qDeMucneJiyW6pJ6" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Indiranagar</a>
        <a href="https://maps.app.goo.gl/Y2V4W84xrxFaoy4i7" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Rajajinagar</a>
        <a href=" https://maps.app.goo.gl/wMuEvTCyNGn3PBsz5" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Yelahanka</a>
		<a href="https://maps.app.goo.gl/9KVaxGz7L6wk5vxTA" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Mumbai</a>
        <a href="https://maps.app.goo.gl/JbwWdkFbs4g6i3eB7" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Mangalore</a>
		<a href="https://maps.app.goo.gl/p2uveXTr5x26nKjM8" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Hubballi</a>
		<a href="https://maps.app.goo.gl/PzmWLqwNysJ3ahhAA" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Delhi</a>
		<a href="https://maps.app.goo.gl/QV7G6afw5bQYBPtv7" target="_blank" rel="noopener" class="location-btn block rounded-xl border-none bg-[#f5f5f5] px-4 py-3 text-center text-[14px] font-medium text-[#111] no-underline cursor-pointer [transition:all_0.2s] hover:-translate-y-0.5 hover:bg-[#e5e5e5]">Lucknow</a>
      </div>
    </div>
    
    <!-- Expanded Content - Contact -->
    <div class="hidden w-full" id="contactContent">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-[16px] font-semibold text-[#111]">Get in Touch</span>
        <button class="flex h-8 w-8 items-center justify-center rounded-full border-none bg-[#f5f5f5] text-[20px] text-[#666] cursor-pointer [transition:background_0.2s] hover:bg-[#e5e5e5]" id="closeContact" type="button">×</button>
      </div>
      <div class="flex flex-col gap-[10px]">
        <a href="https://wa.me/+919611773811" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-xl border-none px-5 py-[14px] text-center text-[15px] font-medium no-underline cursor-pointer [transition:all_0.2s] bg-[#f7f7f7] text-black hover:bg-[#20BA5A]" id="whatsappBtn">
          <span></span> WhatsApp
        </a>
        <a href="tel:08065903131" class="flex items-center justify-center gap-2 rounded-xl border-none px-5 py-[14px] text-center text-[15px] font-medium no-underline cursor-pointer [transition:all_0.2s] bg-brand text-white hover:bg-[#0062CC]" id="callBtn">
          <span></span> Call Now
        </a>
      </div>
    </div>
  </div>
  
<script is:inline>
(function () {
  "use strict";

  document.addEventListener("DOMContentLoaded", function () {

    /* ===============================
       CONFIG (ARRAY BASED – SAFE)
    =============================== */
    const config = {
      // Pages where CTA should open Google Maps directly
      getDirectionPages: [
        "/mangalore/",
        "best-ayurvedic-body-pains-treatment-mangalore",
        "best-ayurvedic-diabetes-reversal-treatment-mangalore",
        "best-ayurvedic-skin-care-treatment-mangalore",
      ],

      // Pages where only limited locations should show
      limitedLocationPages: [
        "/bangalore/",
		"/best-ayurvedic-skin-care-treatment-bangalore/",
		"/best-ayurvedic-treatment-for-weight-loss/",
		"/best-ayurvedic-body-pains-treatment-bangalore/",
		 "/best-ayurvedic-diabetes-reversal-treatment/",
		 "/best-piles-and-fistula-ayurvedic-treatment/",
      ],

      // Default pages (explicit)
      defaultLocationPages: [
        "/",
      ],

      // Locations allowed on limited pages
      limitedLocations: [
        "Chamrajpet",
        "Rajajinagar",
        "Yelahanka"
      ],

      phoneDefault: "08065903131",
      phoneMangalore: "08065903136",
      whatsappDefault: "+919611773811",
      whatsappMangalore: "+919611773811",

      mangaloreMap: "https://maps.app.goo.gl/JbwWdkFbs4g6i3eB7"
    };

    /* ===============================
       PAGE DETECTION (ROBUST)
    =============================== */
    const path = window.location.pathname.toLowerCase();

    const isGetDirectionPage = config.getDirectionPages.some(slug =>
      path === slug || path.startsWith(slug) || path.includes(slug)
    );

    const isLimitedLocationPage = config.limitedLocationPages.some(slug =>
      path === slug || path.startsWith(slug)
    );

    const isDefaultPage = config.defaultLocationPages.includes(path);

    console.log("📍 CTA Page Mode:", {
      path,
      isGetDirectionPage,
      isLimitedLocationPage,
      isDefaultPage
    });

    /* ===============================
       ELEMENTS
    =============================== */
    const el = {
      container: document.getElementById("stickyCta"),
      locationsToggle: document.getElementById("locationsToggle"),
      contactToggle: document.getElementById("contactToggle"),
      locationsContent: document.getElementById("locationsContent"),
      contactContent: document.getElementById("contactContent"),
      closeLocations: document.getElementById("closeLocations"),
      closeContact: document.getElementById("closeContact"),
      locationsGrid: document.getElementById("locationsGrid"),
      whatsappBtn: document.getElementById("whatsappBtn"),
      callBtn: document.getElementById("callBtn"),
    };

    if (!el.container || !el.locationsToggle || !el.contactToggle) {
      console.warn("❌ Sticky CTA elements missing");
      return;
    }

    /* ===============================
       BUTTON TEXT
    =============================== */
    el.locationsToggle.textContent = isGetDirectionPage
      ? "Get Directions"
      : "Our Locations";

    /* ===============================
       HELPERS
    =============================== */
    function resetCTA() {
      el.container.classList.remove("expanded");
      el.locationsContent.style.display = "none";
      el.contactContent.style.display = "none";
    }

    function openLocations() {
      el.container.classList.add("expanded");
      el.locationsContent.style.display = "block";
      el.contactContent.style.display = "none";
    }

    function openContact() {
      el.container.classList.add("expanded");
      el.contactContent.style.display = "block";
      el.locationsContent.style.display = "none";
    }

    /* ===============================
       FILTER LIMITED LOCATIONS
    =============================== */
    if (isLimitedLocationPage && el.locationsGrid) {
      el.locationsGrid.querySelectorAll(".location-btn").forEach(btn => {
        const name = btn.textContent.trim();
        if (!config.limitedLocations.includes(name)) {
          btn.style.display = "none";
        }
      });
      console.log("🏙️ Limited locations applied");
    }

    /* ===============================
       CONTACT LINKS
    =============================== */
    if (el.whatsappBtn) {
      el.whatsappBtn.href =
        "https://wa.me/" +
        (isGetDirectionPage ? config.whatsappMangalore : config.whatsappDefault);
    }

    if (el.callBtn) {
      el.callBtn.href =
        "tel:" +
        (isGetDirectionPage ? config.phoneMangalore : config.phoneDefault);
    }

    /* ===============================
       LOCATIONS BUTTON CLICK
       (NO EARLY EXIT BUGS)
    =============================== */
    el.locationsToggle.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();

      if (isGetDirectionPage) {
        window.open(config.mangaloreMap, "_blank");
        return;
      }

      // Default + Limited → open panel
      openLocations();
    });

    /* ===============================
       CONTACT BUTTON CLICK
    =============================== */
    el.contactToggle.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      openContact();
    });

    /* ===============================
       CLOSE BUTTONS
    =============================== */
    el.closeLocations.addEventListener("click", function (e) {
      e.preventDefault();
      resetCTA();
    });

    el.closeContact.addEventListener("click", function (e) {
      e.preventDefault();
      resetCTA();
    });

    /* ===============================
       OUTSIDE CLICK CLOSE
    =============================== */
    document.addEventListener("click", function (e) {
      if (
        el.container.classList.contains("expanded") &&
        !el.container.contains(e.target)
      ) {
        resetCTA();
      }
    });

  });
})();
</script>
  
