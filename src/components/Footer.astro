<script is:inline id="form-js-js" src="/assets/themes/blocksy-child/forms/global-form-loader.js"></script>
<script is:inline>
    (function () {
        'use strict';

        const GOOGLE_SCRIPT_URL =
            'https://script.google.com/macros/s/AKfycbwq7y_yrRp5eQ8yBi6oQqfNJ_utptbw9LymT_JjjjhjPaDBdnmaemGQ7Tuex5kWEuuKfw/exec';

        function initPvContactForm() {
            const existingForm =
                document.getElementById('pvContactForm');

            if (!existingForm) {
                return;
            }

            /*
             * Clone the form to remove all previous
             * submit listeners added by old scripts.
             */
            const form =
                existingForm.cloneNode(true);

            existingForm.parentNode.replaceChild(
                form,
                existingForm
            );

            const fullNameField =
                form.querySelector('#pvFullName');

            const emailField =
                form.querySelector('#pvEmail');

            const phoneField =
                form.querySelector('#pvPhone');

            const messageField =
                form.querySelector('#pvMessage');

            const successBox =
                form.querySelector('#pvSuccessMessage');

            const errorBox =
                form.querySelector('#pvErrorMessage');

            const submitButton =
                form.querySelector(
                    'button[type="submit"]'
                );

            if (
                !fullNameField ||
                !emailField ||
                !phoneField ||
                !messageField ||
                !successBox ||
                !errorBox ||
                !submitButton
            ) {
                return;
            }

            const originalButtonText =
                submitButton.textContent.trim();

            let successTimer = null;
            let errorTimer = null;

            fullNameField.setAttribute(
                'required',
                'required'
            );

            fullNameField.setAttribute(
                'minlength',
                '2'
            );

            fullNameField.setAttribute(
                'maxlength',
                '80'
            );

            emailField.setAttribute(
                'required',
                'required'
            );

            emailField.setAttribute(
                'type',
                'email'
            );

            phoneField.setAttribute(
                'required',
                'required'
            );

            phoneField.setAttribute(
                'type',
                'tel'
            );

            phoneField.setAttribute(
                'inputmode',
                'numeric'
            );

            phoneField.setAttribute(
                'maxlength',
                '10'
            );

            phoneField.setAttribute(
                'pattern',
                '[0-9]{10}'
            );

            messageField.setAttribute(
                'required',
                'required'
            );

            messageField.setAttribute(
                'minlength',
                '3'
            );

            messageField.setAttribute(
                'maxlength',
                '1000'
            );

            function hideSuccess() {
                if (successTimer) {
                    clearTimeout(successTimer);
                    successTimer = null;
                }

                successBox.classList.add('hidden');
                successBox.style.display = 'none';
            }

            function hideError() {
                if (errorTimer) {
                    clearTimeout(errorTimer);
                    errorTimer = null;
                }

                errorBox.classList.add('hidden');
                errorBox.style.display = 'none';
            }

            function hideMessages() {
                hideSuccess();
                hideError();
            }

            function showSuccess(message) {
                hideMessages();

                successBox.textContent = message;
                successBox.classList.remove('hidden');
                successBox.style.display = 'block';

                successTimer = setTimeout(
                    function () {
                        hideSuccess();
                    },
                    5000
                );
            }

            function showError(message) {
                hideMessages();

                errorBox.textContent = message;
                errorBox.classList.remove('hidden');
                errorBox.style.display = 'block';

                errorTimer = setTimeout(
                    function () {
                        hideError();
                    },
                    6000
                );
            }

            function setLoading(isLoading) {
                submitButton.disabled = isLoading;

                submitButton.textContent =
                    isLoading
                        ? 'Submitting...'
                        : originalButtonText;
            }

            function isValidName(name) {
                return (
                    name.length >= 2 &&
                    name.length <= 80 &&
                    /^[\p{L}][\p{L}\s.'-]*$/u.test(name)
                );
            }

            function isValidEmail(email) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
                    email
                );
            }

            /*
             * Allow only numbers and limit
             * the phone number to 10 digits.
             */
            phoneField.addEventListener(
                'input',
                function () {
                    this.value = this.value
                        .replace(/[^0-9]/g, '')
                        .slice(0, 10);
                }
            );

            hideMessages();

            form.addEventListener(
                'submit',
                async function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();

                    hideMessages();

                    const fullName =
                        fullNameField.value.trim();

                    const email =
                        emailField.value.trim();

                    const phoneNumber =
                        phoneField.value
                            .replace(/[^0-9]/g, '')
                            .trim();

                    const message =
                        messageField.value.trim();

                    if (!isValidName(fullName)) {
                        showError(
                            'Please enter a valid full name.'
                        );

                        fullNameField.focus();
                        return;
                    }

                    if (!isValidEmail(email)) {
                        showError(
                            'Please enter a valid email address.'
                        );

                        emailField.focus();
                        return;
                    }

                    if (!/^[0-9]{10}$/.test(phoneNumber)) {
                        showError(
                            'Please enter exactly 10 digits for the phone number.'
                        );

                        phoneField.focus();
                        return;
                    }

                    if (
                        message.length < 3 ||
                        message.length > 1000
                    ) {
                        showError(
                            'Message must contain between 3 and 1000 characters.'
                        );

                        messageField.focus();
                        return;
                    }

                    setLoading(true);

                    const formData =
                        new URLSearchParams();

                    formData.append(
                        'form_type',
                        'get_in_touch'
                    );

                    formData.append(
                        'full_name',
                        fullName
                    );

                    formData.append(
                        'email',
                        email
                    );

                    formData.append(
                        'country_code',
                        '+91'
                    );

                    formData.append(
                        'phone_number',
                        phoneNumber
                    );

                    formData.append(
                        'message',
                        message
                    );

                    formData.append(
                        'page_url',
                        window.location.href
                    );

                    try {
                        await fetch(
                            GOOGLE_SCRIPT_URL,
                            {
                                method: 'POST',
                                mode: 'no-cors',
                                body: formData
                            }
                        );

                        form.reset();

                        showSuccess(
                            'Thank you! Your request has been submitted successfully.'
                        );

                    } catch (error) {
                        showError(
                            'Something went wrong. Please try again.'
                        );

                    } finally {
                        setLoading(false);
                    }
                },
                true
            );
        }

        if (document.readyState === 'loading') {
            document.addEventListener(
                'DOMContentLoaded',
                initPvContactForm
            );
        } else {
            initPvContactForm();
        }
    })();
    </script>
