                <div class="pv-blog-cards [@media(pointer:coarse)]:!flex [@media(pointer:coarse)]:gap-4 [@media(pointer:coarse)]:overflow-x-auto [@media(pointer:coarse)]:snap-x [@media(pointer:coarse)]:snap-mandatory [@media(pointer:coarse)]:pb-[10px] [@media(pointer:coarse)]:scrollbar-hide [@media(pointer:coarse)]:[&>*]:flex-[0_0_85%] [@media(pointer:coarse)]:[&>*]:snap-start grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    
    <LatestPostCards count={3} decoding="async" />

                    </div>

                <!-- ✅ Dots (mobile only via CSS) -->
                <div class="pv-blog-dots hidden justify-center gap-[10px] mt-[30px] max-[768px]:flex max-[768px]:!mt-[15px] [@media(pointer:coarse)]:!flex [@media(pointer:coarse)]:justify-center [@media(pointer:coarse)]:gap-[10px] [@media(pointer:coarse)]:mt-[14px] [@media(pointer:fine)]:!hidden" aria-label="Blog carousel navigation"></div>
            </div>

            <!-- ✅ Mobile carousel CSS + JS (scoped to this shortcode instance) -->

            <script is:inline>
                (function () {
                    var root = document.getElementById('pv_blog_1');
                    if (!root) return;

                    var track = root.querySelector('.pv-blog-cards');
                    var dotsWrap = root.querySelector('.pv-blog-dots');
                    if (!track || !dotsWrap) return;

                    var cards = Array.prototype.slice.call(track.children).filter(function (n) {
                        return n && n.nodeType === 1;
                    });

                    // Only needed on mobile + if more than 1 card
                    if (!window.matchMedia('(pointer: coarse)').matches || cards.length <= 1) return;

                    dotsWrap.innerHTML = '';
                    var dots = cards.map(function (_, i) {
                        var b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'pv-blog-dot h-2 w-2 cursor-pointer rounded-[999px] border-0 bg-[#cbd5e1] p-0 [transition:all_0.3s_ease] [&.is-active]:w-[18px] [&.is-active]:bg-[#111827] [&.is-active]:[transition:width_0.2s_ease]' + (i === 0 ? ' is-active' : '');
                        b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
                        b.addEventListener('click', function () {
                            var target = cards[i];
                            track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
                        });
                        dotsWrap.appendChild(b);
                        return b;
                    });

                    function setActiveByScroll() {
                        var left = track.scrollLeft;
                        var bestIdx = 0;
                        var bestDist = Infinity;

                        for (var i = 0; i < cards.length; i++) {
                            var dist = Math.abs(cards[i].offsetLeft - left);
                            if (dist < bestDist) {
                                bestDist = dist;
                                bestIdx = i;
                            }
                        }

                        dots.forEach(function (d, idx) {
                            if (idx === bestIdx) d.classList.add('is-active');
                            else d.classList.remove('is-active');
                        });
                    }

                    var raf = null;
                    track.addEventListener('scroll', function () {
                        if (raf) cancelAnimationFrame(raf);
                        raf = requestAnimationFrame(setActiveByScroll);
                    }, { passive: true });

                    // init
                    setActiveByScroll();
                })();
            </script>
        </section>

