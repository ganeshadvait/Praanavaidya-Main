<script is:inline>
(function () {
  const carousel = document.getElementById("pv-carousel");
  const source = document.getElementById("pv-treatment-items");
  if (!carousel || !source) return;

  const items = Array.from(source.children).map(i => i.cloneNode(true));
  let currentCount = null;

  // timings
  const AUTO_INTERVAL_MS = 2500;   // scroll every 3 seconds
  const RESUME_AFTER_MS  = 5000;   // resume 5s after user action
  const START_DELAY_MS   = 4500;   // first scroll 3s after it becomes visible

  function perSlide() {
    return window.matchMedia("(max-width: 768px)").matches ? 4 : 6;
  }

  function buildSlides(count) {
    carousel.querySelectorAll(".pv-slide").forEach(s => s.remove());

    for (let i = 0; i < items.length; i += count) {
      const slide = document.createElement("div");
      slide.className = "pv-slide grid min-w-full snap-start gap-6 p-4 min-[769px]:grid-cols-3 max-[768px]:grid-cols-1";
      slide.style.flex = "0 0 100%"; // important for flex scrolling

      items.slice(i, i + count).forEach(item => {
        slide.appendChild(item.cloneNode(true));
      });

      carousel.appendChild(slide);
    }

    carousel.scrollLeft = 0;
  }

  function apply() {
    const count = perSlide();
    if (count === currentCount) return;
    currentCount = count;
    buildSlides(count);
  }

  window.pvScroll = function (dir) {
    const slide = carousel.querySelector(".pv-slide");
    const width = slide ? slide.getBoundingClientRect().width : carousel.clientWidth;
    carousel.scrollBy({ left: dir * width, behavior: "smooth" });
  };

  function atEnd() {
    return carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 4;
  }

  function goNextLooping() {
    if (atEnd()) {
      carousel.scrollTo({ left: 0, behavior: "smooth" });
    } else {
      window.pvScroll(1);
    }
  }

  apply();

  // ========= AUTOPLAY CONTROL (viewport + hover + user actions) =========
  let intervalId = null;
  let startTimeoutId = null;
  let resumeTimeoutId = null;

  let isHovering = false;
  let inView = false;

  function stopAuto() {
    if (intervalId) clearInterval(intervalId);
    intervalId = null;

    if (startTimeoutId) clearTimeout(startTimeoutId);
    startTimeoutId = null;
  }

  function startAutoWithDelay() {
    stopAuto();

    // only run if scrollable and in view
    if (!inView) return;
    if (carousel.scrollWidth <= carousel.clientWidth + 2) return;

    // first move after 3s, then every 3s
    startTimeoutId = setTimeout(() => {
      if (!inView || isHovering) return;
      goNextLooping();

      intervalId = setInterval(() => {
        if (!inView || isHovering) return;
        goNextLooping();
      }, AUTO_INTERVAL_MS);
    }, START_DELAY_MS);
  }

  function pauseAndResumeLater() {
    stopAuto();
    if (resumeTimeoutId) clearTimeout(resumeTimeoutId);

    // resume 5s after last interaction (only if still in view)
    resumeTimeoutId = setTimeout(() => {
      startAutoWithDelay(); // will wait 3s before moving again
    }, RESUME_AFTER_MS);
  }

  // hover pause
  carousel.addEventListener("mouseenter", () => {
    isHovering = true;
    stopAuto();
  });
  carousel.addEventListener("mouseleave", () => {
    isHovering = false;
    startAutoWithDelay();
  });

  // user interaction pause (cards/drag/scroll/touch/click)
  ["wheel", "scroll", "touchstart", "touchmove", "pointerdown", "pointermove", "click"].forEach(evt => {
    carousel.addEventListener(evt, pauseAndResumeLater, { passive: true });
  });

  // viewport detection
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        inView = entry.isIntersecting;
        if (inView) {
          startAutoWithDelay();
        } else {
          stopAuto();
        }
      });
    },
    { threshold: 0.25 } // 25% visible counts as in view
  );

  io.observe(carousel);

  // rebuild on resize and restart autoplay logic
  window.addEventListener("resize", () => {
    clearTimeout(window._pvResize);
    window._pvResize = setTimeout(() => {
      apply();
      // if user resized while in view, restart timers cleanly
      if (inView && !isHovering) startAutoWithDelay();
    }, 150);
  });
})();
</script>

