<script is:inline>
/* -----------------------------------------
   Toggle FAQ (Updated)
------------------------------------------ */
function pv_toggleFAQ(i) {
    const container = document.getElementById("pv-faq-container");
    const answers = container.querySelectorAll(".pv-faq-answer");
    const icons = container.querySelectorAll(".pv-faq-toggle");
    const questions = container.querySelectorAll(".pv-faq-question");

    answers.forEach((ans, idx) => {
        if (idx === i) {
            const isOpen = ans.classList.contains('open');
            
            if (isOpen) {
                ans.style.maxHeight = "0px";
                ans.classList.remove('open');
                icons[idx].textContent = "+";
                icons[idx].classList.remove('active');
                questions[idx].classList.remove('active');
            } else {
                ans.style.maxHeight = ans.scrollHeight + "px";
                ans.classList.add('open');
                icons[idx].textContent = "−";
                icons[idx].classList.add('active');
                questions[idx].classList.add('active');
            }
        } else {
            ans.style.maxHeight = "0px";
            ans.classList.remove('open');
            icons[idx].textContent = "+";
            icons[idx].classList.remove('active');
            questions[idx].classList.remove('active');
        }
    });
}

// Initialize on page load
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
        pv_renderFAQ();
    });
} else {
    pv_renderFAQ();
}
</script>

