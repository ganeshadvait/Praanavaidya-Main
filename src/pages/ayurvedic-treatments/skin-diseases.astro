<script is:inline>
document.addEventListener('DOMContentLoaded', function () {

  document.querySelectorAll('.doctor-carousel-wrapper').forEach(wrapper => {
    const carousel = wrapper.querySelector('.doctor-carousel');
    const nextBtn  = wrapper.querySelector('.doctor-next');
    const prevBtn  = wrapper.querySelector('.doctor-prev');

    if (!carousel) return;

    // --- Settings ---
    const AUTO_SCROLL_EVERY_MS = 3000;       // 3 seconds
    const PAUSE_AFTER_INTERACTION_MS = 5000; // 5 seconds

    let autoplayInterval = null;
    let resumeTimeout = null;

    function scrollAmount() {
      const card = carousel.querySelector('.doctor-grid-card');
      return card ? (card.offsetWidth + 32) : 300;
    }

    function atEnd() {
      return carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 5;
    }

    function scrollNext() {
      if (atEnd()) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      }
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayInterval = setInterval(scrollNext, AUTO_SCROLL_EVERY_MS);
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    function pauseThenResume() {
      stopAutoplay();
      if (resumeTimeout) clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(startAutoplay, PAUSE_AFTER_INTERACTION_MS);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
        pauseThenResume();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
        pauseThenResume();
      });
    }

    ['touchstart', 'pointerdown', 'wheel'].forEach(evt => {
      carousel.addEventListener(evt, pauseThenResume, { passive: true });
    });

    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', pauseThenResume);

    startAutoplay();
  });

});
</script>

