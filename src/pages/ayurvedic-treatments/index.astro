<!-- HERO SECTION -->
<div class="mb-12 max-[768px]:!mb-[25px]">
        
    <section class="relative bg-[#0595C4] text-white text-center px-4 py-24 rounded-b-3xl overflow-hidden">

        <!-- Badge -->
<!--         <div class="inline-block bg-white/20 px-4 py-1.5 rounded-full text-sm font-medium mb-6">
                    </div> -->

        <!-- Heading -->
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4 text-white leading-[1.8em]">
            Comprehensive<br>
            <span class="text-[#fff]">HealthCare</span> Services
        </h1>

        <!-- Description -->
        <p class="max-w-2xl mx-auto text-lg text-white/90 mb-8 max-[768px]:!mb-[18px]">
            From routine checkups to specialized treatments, we combine modern technology with a human touch to keep your loved ones healthy.        </p>

        <!-- CTA Button -->
        <a href="#" 
           class=" open-modal inline-block bg-white text-gray-900 font-semibold px-6 py-3 rounded-full shadow-lg hover:shadow-xl transition hover:scale-[1.03]">
