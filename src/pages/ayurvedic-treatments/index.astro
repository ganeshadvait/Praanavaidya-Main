                    <a href="/ayurvedic-treatments/lipoma/" class="[transition:all_0.4s_cubic-bezier(0.4,0,0.2,1)] hover:-translate-y-2 bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl border border-slate-100 cursor-pointer block">
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-slate-900 mb-3 hover:text-[#0595C4] transition-colors duration-300 text-left">
                            Lipoma Treatment In Ayurveda                        </h3>
                        
                        <!-- Description -->
                        <p class="text-slate-600 text-sm leading-relaxed text-left">
