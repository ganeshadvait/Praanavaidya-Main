                    </a>
                                    <!-- Wrap the entire card content in a clickable <a> tag -->
                    <a href="/ayurvedic-treatments/anal-fistula/" class="[transition:all_0.4s_cubic-bezier(0.4,0,0.2,1)] hover:-translate-y-2 bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl border border-slate-100 cursor-pointer block">
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-slate-900 mb-3 hover:text-[#0595C4] transition-colors duration-300 text-left">
                            Fistula Treatment In Ayurveda                        </h3>
                        
