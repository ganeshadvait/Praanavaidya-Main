<script is:inline>
(function () {
    /* ─── Config — keep in sync with PHP ──────────────── */
    var CARD_W  = 280;   /* matches style="width:280px"  */
    var GAP     = 24;    /* matches gap-24px in CSS      */
    var CLONE   = 4;     /* matches $CLONE in PHP        */
    var N       = 12; /* total real videos */
    var AUTO_MS = 3000;  /* ms between auto-advances    */

    var STEP = CARD_W + GAP;  /* pixels per card slot */

    /* ─── DOM refs ─────────────────────────────────────── */
    var track    = document.getElementById('pvTalkTrack');
    var viewport = document.getElementById('pvTalkViewport');
    var btnPrev  = document.getElementById('pvPrevTalk');
    var btnNext  = document.getElementById('pvNextTalk');

    if (!track || !viewport) return;

    /* ─── State ─────────────────────────────────────────── */
    var idx  = CLONE;   /* index in extended array — starts at first real card */
    var busy = false;   /* locked while a CSS transition is in flight           */
    var timer;

    /* ─── Helpers ───────────────────────────────────────── */
    function applyPos(animate) {
        /* Add/remove the transition class so we control exactly when it runs */
        if (animate) {
            track.classList.add('pv-animating');
        } else {
            track.classList.remove('pv-animating');
        }
        track.style.transform = 'translateX(' + (-(idx * STEP)) + 'px)';
    }

    /* Set the initial position instantly — no animation */
    applyPos(false);

    /* ─── Boundary correction after each transition ─────── */
    /*
     * When we slide into a clone region, transitionend fires.
     * At that point we instantly (no animation) jump to the
     * equivalent real card. The user sees the clone slide in
     * identically to the real card, then the position silently
     * corrects — completely invisible.
     */
    track.addEventListener('transitionend', function () {
        busy = false;

        if (idx >= CLONE + N) {
            /* Went past the appended clones — wrap to real start */
            idx = CLONE + (idx - (CLONE + N));
            applyPos(false);
        } else if (idx < CLONE) {
            /* Went before the prepended clones — wrap to real end */
            idx = CLONE + N - (CLONE - idx);
            applyPos(false);
        }
    });

    /* ─── Move one step in a direction ─────────────────── */
    function move(dir) {
        if (busy) return;   /* ignore clicks mid-transition */
        busy = true;
        idx += dir;
        applyPos(true);
    }

    /* ─── Button listeners ──────────────────────────────── */
    btnNext.addEventListener('click', function () { move(1);  resetAuto(); });
    btnPrev.addEventListener('click', function () { move(-1); resetAuto(); });

    /* ─── Auto-play ─────────────────────────────────────── */
    function startAuto() {
        clearInterval(timer);
        timer = setInterval(function () { move(1); }, AUTO_MS);
    }

    function resetAuto() {
        /* Restart the countdown so a manual click doesn't cause an
           immediate auto-advance right after */
        startAuto();
    }

    startAuto();

    /* ─── Pause on hover / touch ────────────────────────── */
    viewport.addEventListener('mouseenter', function () { clearInterval(timer); });
    viewport.addEventListener('mouseleave', startAuto);
    viewport.addEventListener('touchstart', function () { clearInterval(timer); }, { passive: true });
    viewport.addEventListener('touchend',   startAuto, { passive: true });

    /* ─── Reapply position on resize (layout shift) ─────── */
    window.addEventListener('resize', function () { applyPos(false); });

})();
</script>

