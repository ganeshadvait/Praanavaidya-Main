---
<BaseLayout seo={seo} bodyClass={page.bodyClass}>
	<div
		class="ct-container-full"
				data-content="normal"		>

	<article
		id="post-89"
		class="post-89 page type-page status-publish hentry">

		<div class="entry-content is-layout-constrained">
				<section class="w-full bg-[#0595C4] text-white py-14 sm:py-28 rounded-b-[0px] sm:rounded-b-[42px] mb-0">
    <div class="container mx-auto px-4 text-center max-w-3xl">

        <!-- Title -->
        <h1 class="text-4xl md:text-7xl font-bold leading-tight mb-6 text-white">
            Healing Lives Through Authentic Ayurvedic Wisdom        </h1>

        <!-- Description -->
        <p class="text-lg md:text-xl opacity-90 mb-10">
            Praanavaidya in Bangalore offers personalized Ayurvedic care combining ancient science, modern diagnosis, and community-driven healing.        </p>

        <!-- CTA Button -->
        <div class="flex justify-center">
            <button
                class="open-modal bg-white text-[#0595C4] hover:bg-gray-100
                       px-8 py-4 rounded-full font-medium
                       inline-flex items-center justify-center gap-2 whitespace-nowrap">
                Join the Community                <span>→</span>
            </button>
        </div>

    </div>
</section>

<section class="w-full py-20 bg-white sm:h-[700px] h-[900px] ">
    <div class="container mx-auto px-6 text-center">

        <!-- Main Title -->
        <h2 class="text-3xl md:text-4xl font-semibold text-gray-900">
            Rooted In Holistic Healing        </h2>

        <!-- Subtitle -->
        <p class="text-gray-600 mt-3 max-w-xl mx-auto">
            Traditional Ayurvedic principles adapted for today’s modern lifestyles.        </p>

        <!-- Perks Grid -->
        <div class="relative mt-12">

			<!-- Slider container -->
			<div id="perks-slider"
				 class="flex gap-6 overflow-x-auto snap-x snap-mandatory px-1 
						md:grid md:grid-cols-4 md:gap-6 md:overflow-visible md:px-0
						[scrollbar-width:none] [-ms-overflow-style:none] 
						[&::-webkit-scrollbar]:hidden">

				<!-- Card 1 -->
				<div class="bg-gray-50 rounded-2xl shadow-sm p-6 text-center 
							min-w-[80%] snap-center md:min-w-0">
					<div class="pb-4 flex items-center justify-center bg-white mx-auto w-[55px] h-[55px] border border-gray rounded-[16px]">
						<img decoding="async" 
            src="/images/2026/01/Diagnosis.avif" 
            alt="Ayurvedic diagnosis" 
            class="mx-auto w-[32px] h-[32px] object-contain" 
        />
					</div>
					<h4 class="font-bold text-gray-900">Diagnosis</h4>
					<p class="font-semibold text-gray-600 text-sm">
						Deep assessment beyond surface symptoms
					</p>
					<p class="text-gray-600 text-sm mt-2">
						We identify root imbalances using classical methods and modern clinical understanding.
					</p>
				</div>

				<!-- Card 2 -->
				<div class="bg-gray-50 rounded-2xl shadow-sm p-6 text-center 
							min-w-[80%] snap-center md:min-w-0">
					<div class="pb-4 flex items-center justify-center bg-white mx-auto w-[55px] h-[55px] border border-gray rounded-[16px]">
						<img decoding="async" 
            src="/images/2026/01/Treatment.avif" 
            alt="Ayurvedic treatment" 
            class="mx-auto w-[32px] h-[32px] object-contain" 
        />
					</div>
					<h4 class="font-semibold text-gray-900">Treatment</h4>
					<p class="font-semibold text-gray-600 text-sm">
						Personalized therapies for lasting results
					</p>
					<p class="text-gray-600 text-sm mt-2">
						Each treatment plan aligns body constitution, condition severity, and lifestyle factors.
					</p>
				</div>

				<!-- Card 3 -->
				<div class="bg-gray-50 rounded-2xl shadow-sm p-6 text-center 
							min-w-[80%] snap-center md:min-w-0">
					<div class="pb-4 flex items-center justify-center bg-white mx-auto w-[55px] h-[55px] border border-gray rounded-[16px]">
						<img decoding="async" 
            src="/images/2026/01/Lifestyle.avif" 
            alt="Ayurvedic lifestyle" 
            class="mx-auto w-[32px] h-[32px] object-contain" 
        />
					</div>
					<h4 class="font-semibold text-gray-900">Lifestyle</h4>
					<p class="font-semibold text-gray-600 text-sm">
						Daily habits that restore balance
					</p>
					<p class="text-gray-600 text-sm mt-2">
						We guide sustainable routines supporting digestion, sleep, immunity, and mental clarity.
					</p>
				</div>

				<!-- Card 4 -->
				<div class="bg-gray-50 rounded-2xl shadow-sm p-6 text-center 
							min-w-[80%] snap-center md:min-w-0">
					<div class="pb-4 flex items-center justify-center bg-white mx-auto w-[55px] h-[55px] border border-gray rounded-[16px]">
						<img decoding="async" 
            src="/images/2026/01/Community.avif" 
            alt="Ayurvedic wellness community" 
            class="mx-auto w-[32px] h-[32px] object-contain" 
        />
					</div>
					<h4 class="font-semibold text-gray-900">Community</h4>
					<p class="font-semibold text-gray-600 text-sm">
						Healing supported through shared learning
					</p>
					<p class="text-gray-600 text-sm mt-2">
						Our community fosters accountability, education, and collective growth toward wellness.
					</p>
				</div>

			</div>

			<!-- Navigation Arrows (Mobile only) -->
			<div class="flex justify-end gap-4 mt-6 md:hidden">
				<button id="slider-prev"
						class="w-10 h-10 bg-teal-500 text-white rounded-full flex items-center justify-center">
					←
				</button>
				<button id="slider-next"
						class="w-10 h-10 bg-teal-500 text-white rounded-full flex items-center justify-center">
					→
				</button>
			</div>
		</div>
    </div>
</section>

<!-- Founder Message Section -->
<section class="w-full py-8 sm:py-20 bg-[#FFF7F2]">
    <div class="container mx-auto px-6 text-center -mt-[370px] sm:-mt-[300px]">

        <h3 class="text-2xl md:text-3xl font-semibold text-gray-800 italic">
            “ Ayurveda Explained Through Experience ”
        </h3>

        <div class="mt-10 flex justify-center">
            <div class="rounded-2xl bg-black w-full max-w-3xl h-72 md:h-96 overflow-hidden">

                                    <iframe 
                        class="w-full h-full"
                        src="https://www.youtube.com/embed/dQ7kjgAYx88" 
                        frameborder="0" 
                        allowfullscreen>
                    </iframe>
                
            </div>
        </div>

    </div>
</section>
<script is:inline>
document.addEventListener("DOMContentLoaded", function () {
    const slider = document.getElementById("perks-slider");
    const next = document.getElementById("slider-next");
    const prev = document.getElementById("slider-prev");

    const cardWidth = slider.querySelector("div").offsetWidth + 24; // card width + gap

    next.onclick = () => slider.scrollBy({ left: cardWidth, behavior: "smooth" });
    prev.onclick = () => slider.scrollBy({ left: -cardWidth, behavior: "smooth" });
});
</script>

<section class="w-[95%] bg-[#FDF5EF] py-4 sm:py-20 mx-auto">
    <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl font-semibold text-[#0C0C23] mb-10 sm:mb-16">
            DIFFERENT CAMPAIGNS        </h2>
    </div>

    <!-- SECTION 1 -->
    <div class="container mx-auto px-2 sm:px-6 grid md:grid-cols-2 gap-12 items-center mb-28">

        <!-- Image -->
        <div class="flex justify-center">
            <div class="rounded-[28px] shadow-xl bg-white overflow-hidden py-2 px-2">
                <img
                    src="/images/2026/01/2.avif"
                    alt="Ayurvedic Reset Program at Praanavaidya"
                    class="rounded-2xl"
                    loading="lazy"
                    decoding="async"
                />
            </div>
        </div>

        <!-- Text -->
        <div>
            <h3 class="text-3xl font-semibold text-[#0C0C23]">
                Ayurvedic Reset Program            </h3>

            <p class="text-gray-600 mt-4 leading-relaxed">
                A structured wellness journey designed to detoxify, rebalance doshas, and rebuild vitality through guided Ayurvedic therapies, nutrition, and lifestyle corrections.            </p>

            <ul class="text-gray-700 mt-6 space-y-3">
                <li>• Guided detox protocols supervised by experienced Ayurvedic physicians</li>
                <li>• Nutrition plans aligned with individual body constitution</li>
            </ul>
        </div>
    </div>

    <!-- SECTION 2 (flipped layout) -->
    <div class="container mx-auto px-2 sm:px-6 grid md:grid-cols-2 gap-12 items-center">

        <!-- Text -->
        <div class="order-2 md:order-1">
            <h3 class="text-3xl font-semibold text-[#0C0C23]">
                Digestive Health Campaign            </h3>

            <p class="text-gray-600 mt-4 leading-relaxed">
                An Ayurvedic program focused on improving digestion, gut health, metabolism, and energy levels through personalized treatments, dietary guidance, and lifestyle corrections.            </p>

            <ul class="text-gray-700 mt-6 space-y-3">
                <li>• Addresses bloating, acidity, constipation, and poor digestion</li>
                <li>• Strengthens agni for sustained energy and immunity</li>
            </ul>
        </div>

        <!-- Image -->
        <div class="order-1 md:order-2 flex justify-center">
            <div class="rounded-[28px] shadow-xl bg-white overflow-hidden p-2">
                 <img
                    src="/images/2026/01/1.avif"
                    alt="Ayurvedic digestive health treatment at Praanavaidya"
                    class="rounded-2xl"
                    loading="lazy"
                    decoding="async"
                />
            </div>
        </div>

    </div>
</section>

		</div>

	</article>

			</div>

<!-- .ct-container -->
</BaseLayout>
