                    ></iframe>

                </div>

            </div>

            <!-- Right Content -->
            <div class="space-y-10">

                <!-- Form -->
                <div class="w-full">

                    <div class="bg-white md:p-10 p-6 pt-8 rounded-[22px] shadow-xl mt-[30px]">

                        <form id="pvContactForm" class="space-y-6">

                            <!-- Name -->
                            <div>

                                <label class="block mb-1 font-medium text-sm">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    name="full_name"
                                    id="pvFullName"
                                    class="w-full border border-[#E5E5E5] rounded-full px-5 py-3 text-sm focus:outline-none"
                                    placeholder="Enter your full name"
                                    minlength="2"
                                    maxlength="80"
                                    autocomplete="name"
                                    required
                                >

                            </div>

                            <!-- Email -->
                            <div>

                                <label class="block mb-1 font-medium text-sm">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    name="email"
                                    id="pvEmail"
                                    class="w-full border border-[#E5E5E5] rounded-full px-5 py-3 text-sm focus:outline-none"
                                    placeholder="Enter your email address"
                                    maxlength="254"
                                    autocomplete="email"
                                    required
                                >

                            </div>

                            <!-- Phone -->
                            <div>

                                <label class="block mb-1 font-medium text-sm">
                                    Phone Number
                                </label>

                                <input
                                    type="tel"
                                    name="phone_number"
                                    id="pvPhone"
                                    class="w-full border border-[#E5E5E5] rounded-full px-5 py-3 text-sm focus:outline-none"
                                    placeholder="Enter 10-digit phone number"
                                    inputmode="numeric"
                                    pattern="[0-9]{10}"
                                    minlength="10"
                                    maxlength="10"
                                    autocomplete="tel"
                                    required
                                >

                            </div>

                            <!-- Message -->
                            <div>

                                <label class="block mb-1 font-medium text-sm">
                                    Message
                                </label>

                                <textarea
                                    name="message"
                                    id="pvMessage"
                                    class="w-full border border-[#E5E5E5] rounded-2xl px-5 py-3 text-sm h-[120px] resize-none focus:outline-none"
                                    placeholder="Briefly describe your concern"
                                    minlength="3"
                                    maxlength="1000"
                                    required
                                ></textarea>

                            </div>

                            <!-- Submit Button -->
                            <button
                                type="submit"
                                class="w-full py-4 rounded-full text-white font-semibold text-[16px] bg-gradient-to-b from-[#5AD6FF] to-[#0595C4] shadow-lg"
                            >
                                Book an Appointment
                            </button>

                            <!-- Success Message -->
                            <div
                                id="pvSuccessMessage"
                                class="hidden mt-4 p-4 rounded-lg bg-green-50 border border-green-300 text-green-700"
                            >
                                Thank you! Your request has been submitted successfully.
                            </div>

                            <!-- Error Message -->
                            <div
                                id="pvErrorMessage"
                                class="hidden mt-4 p-4 rounded-lg bg-red-50 border border-red-300 text-red-700"
                            >
                                Something went wrong. Please try again.
                            </div>

                        </form>

                    </div>

                </div>
                <!-- Form Ends -->

            </div>

        </div>
    </section>

		</div>

	</article>

			</div>

<!-- .ct-container -->
</BaseLayout>
