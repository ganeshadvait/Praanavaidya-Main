	<div>

	<article
		id="post-10946"
		class="post-10946 page type-page status-publish hentry">

		<div class="page-content">
				
  <div class="relative z-[1] !float-none clear-both !mx-auto !my-0 !block !w-full !max-w-[880px] box-border !px-5 !py-[2.5rem] leading-normal text-[#1f2a2e] max-[768px]:!px-4 max-[768px]:!py-[2rem] max-[380px]:!px-3 max-[380px]:!py-[1.5rem] [&_fieldset]:m-0 [&_fieldset]:mb-[2rem] [&_fieldset]:min-w-0 [&_fieldset]:border-0 [&_fieldset]:p-0 max-[768px]:[&_fieldset]:mb-[1.6rem] [&_fieldset:last-of-type]:mb-5 [&_legend]:mb-[1.1rem] [&_legend]:flex [&_legend]:w-full [&_legend]:items-center [&_legend]:gap-[.6rem] [&_legend]:p-0 [&_legend]:text-[1.05rem] [&_legend]:font-bold [&_legend]:text-[#1f2a2e] max-[600px]:[&_legend]:text-[1rem] [&_legend]:after:h-px [&_legend]:after:flex-1 [&_legend]:after:bg-[#e3e6e4] [&_legend]:after:content-[''] [&_label]:text-[.85rem] [&_label]:font-semibold [&_label]:text-[#1f2a2e] [&_:is(input,select,textarea)]:w-full [&_:is(input,select,textarea)]:max-w-full [&_:is(input,select,textarea)]:rounded-[9px] [&_:is(input,select,textarea)]:[background:#fff] [&_:is(input,select,textarea)]:px-[.75rem] [&_:is(input,select,textarea)]:py-[.7rem] [&_:is(input,select,textarea)]:text-[16px] [&_:is(input,select,textarea)]:text-[#1f2a2e] [&_:is(input,select,textarea)]:[border:1px_solid_#e3e6e4] [&_:is(input,select,textarea)]:[transition:border-color_.15s,box-shadow_.15s] [&_:is(input,select,textarea):focus]:border-brand [&_:is(input,select,textarea):focus]:shadow-[0_0_0_3px_rgba(5,149,196,0.15)] [&_:is(input,select,textarea):focus]:[outline:none] [&_input[type=file]]:cursor-pointer [&_input[type=file]]:[background:#f4f7f5] [&_input[type=file]]:p-[.55rem] [&_:is(input,select).pv-invalid]:border-[#c0392b] [&_:is(input,select).pv-invalid]:shadow-[0_0_0_3px_rgba(192,57,43,0.12)] motion-reduce:[&_*]:!transition-none">

    <div class="mb-[2rem] text-center max-[380px]:mb-[1.5rem] [&_h1]:mb-[.4rem] [&_h1]:mt-0 [&_h1]:text-[clamp(1.5rem,5vw,2.2rem)] [&_h1]:leading-[1.2] [&_p]:m-0 [&_p]:text-[clamp(.88rem,2.5vw,.98rem)] [&_p]:text-[#5d6b66]">
      <span class="mb-2 inline-block text-[.8rem] font-bold uppercase tracking-[.12em] text-brand">Praanavaidya · Careers</span>
      <h1>Application Form</h1>
      <p>Fill in your details below. Fields marked <span class="text-[#c0392b]">*</span> are required.</p>
    </div>

    <form id="pvApplicationForm" class="w-full rounded-xl border border-solid border-[#e3e6e4] bg-white p-7 shadow-[0_1px_4px_rgba(31,42,46,0.05)] max-[768px]:p-6 max-[600px]:p-[1.15rem] max-[380px]:p-4" action="javascript:void(0);" method="post" enctype="multipart/form-data" novalidate>

      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label>Don't fill this <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      </div>

      <fieldset>
        <legend>Basic Information</legend>

        <div class="grid grid-cols-[repeat(2,1fr)] gap-x-5 gap-y-[1.1rem] max-[600px]:grid-cols-[1fr] max-[600px]:gap-4">

          <div class="flex min-w-0 flex-col gap-[.4rem] col-span-full">
            <label for="pv_full_name">Full Name <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_full_name" name="full_name" placeholder="Your full name"
                   pattern="[A-Za-z\s.'-]{2,60}" maxlength="60" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_full_name"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_mobile">Mobile Number <span class="text-[#c0392b]">*</span></label>
            <input type="tel" id="pv_mobile" name="mobile" inputmode="numeric"
                   placeholder="10-digit mobile number" pattern="[6-9][0-9]{9}" maxlength="10" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_mobile"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_email">Email ID <span class="text-[#c0392b]">*</span></label>
            <input type="email" id="pv_email" name="email" placeholder="you@example.com" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_email"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_current_city">Current City <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_current_city" name="current_city" placeholder="City you live in"
                   pattern="[A-Za-z\s.'-]{2,50}" maxlength="50" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_current_city"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_preferred_location">Preferred Job Location <span class="text-[#c0392b]">*</span></label>
            <select id="pv_preferred_location" name="preferred_location" required>
              <option value="">Select a location</option>
              <option>Mangalore</option>
              <option>Hubballi</option>
              <option>Bangalore</option>
              <option>Mumbai</option>
              <option>Delhi</option>
              <option>Lucknow</option>
            </select>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_preferred_location"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem] col-span-full">
            <label for="pv_applying_for">Applying For (Job Role) <span class="text-[#c0392b]">*</span></label>
            <select id="pv_applying_for" name="applying_for" required>
              <option value="">Select a role</option>
              <option>Ayurveda Consultant</option>
              <option>Panchakarma Therapist</option>
              <option>Front Office &amp; Telesales Executive</option>
              <option>Sales Head</option>
              <option>Telesales Executive</option>
              <option>Office Boy</option>
              <option>Marketing Manager</option>
              <option>Nurses</option>
              <option>HR Executive</option>
            </select>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_applying_for"></span>
          </div>

        </div>
      </fieldset>

      <fieldset>
        <legend>Professional Details</legend>

        <div class="grid grid-cols-[repeat(2,1fr)] gap-x-5 gap-y-[1.1rem] max-[600px]:grid-cols-[1fr] max-[600px]:gap-4">

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_total_experience">Total Experience <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_total_experience" name="total_experience" placeholder="e.g. 4 years"
                   pattern="^(?=.*[0-9]).{1,30}$" maxlength="30" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_total_experience"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_relevant_experience">Relevant Experience <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_relevant_experience" name="relevant_experience" placeholder="e.g. 2 years"
                   pattern="^(?=.*[0-9]).{1,30}$" maxlength="30" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_relevant_experience"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_current_company">Current Company <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_current_company" name="current_company" placeholder="Company name" maxlength="80" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_current_company"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_current_designation">Current Designation <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_current_designation" name="current_designation" placeholder="Your job title" maxlength="80" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_current_designation"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_current_salary">Current Salary <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_current_salary" name="current_salary" placeholder="e.g. 4.5 LPA"
                   pattern="^(?=.*[0-9]).{1,20}$" maxlength="20" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_current_salary"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_expected_salary">Expected Salary <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_expected_salary" name="expected_salary" placeholder="e.g. 6 LPA"
                   pattern="^(?=.*[0-9]).{1,20}$" maxlength="20" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_expected_salary"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_languages">Languages Known <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_languages" name="languages" placeholder="e.g. Kannada, Hindi, English" maxlength="100" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_languages"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_qualification">Educational Qualification <span class="text-[#c0392b]">*</span></label>
            <input type="text" id="pv_qualification" name="qualification" placeholder="Highest qualification" maxlength="80" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_qualification"></span>
          </div>

        </div>
      </fieldset>

      <fieldset>
        <legend>Additional Details</legend>

        <div class="grid grid-cols-[repeat(2,1fr)] gap-x-5 gap-y-[1.1rem] max-[600px]:grid-cols-[1fr] max-[600px]:gap-4">

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_resume">Upload Resume  <span class="text-[.78rem] font-normal text-[#5d6b66]">(PDF / DOC / DOCX / JPEG)</span></label>
            <input type="file" id="pv_resume" name="resume" accept=".pdf,.doc,.docx,.jpg,.jpeg" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_resume"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_photo">Photograph  <span class="text-[.78rem] font-normal text-[#5d6b66]">(JPG / PNG)</span></label>
            <input type="file" id="pv_photo" name="photo" accept=".jpg,.jpeg,.png" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_photo"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label>Willing to Relocate? </label>
            <div class="flex flex-wrap gap-5 pt-[.2rem] max-[380px]:gap-4 [&_input]:!w-auto [&_label]:flex [&_label]:cursor-pointer [&_label]:items-center [&_label]:gap-[.4rem] [&_label]:!font-normal">
              <label><input type="radio" name="relocate" value="Yes" required> Yes</label>
              <label><input type="radio" name="relocate" value="No" required> No</label>
            </div>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_relocate"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label>Preferred Interview Mode </label>
            <div class="flex flex-wrap gap-5 pt-[.2rem] max-[380px]:gap-4 [&_input]:!w-auto [&_label]:flex [&_label]:cursor-pointer [&_label]:items-center [&_label]:gap-[.4rem] [&_label]:!font-normal">
              <label><input type="radio" name="interview_mode" value="Online" required> Online</label>
              <label><input type="radio" name="interview_mode" value="Offline" required> Offline</label>
            </div>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_interview_mode"></span>
          </div>

          <div class="flex min-w-0 flex-col gap-[.4rem]">
            <label for="pv_interview_date">Available Date for Interview </label>
            <input type="date" id="pv_interview_date" name="interview_date" required>
            <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_interview_date"></span>
          </div>

        </div>
      </fieldset>

      <label class="mx-0 mb-0 mt-5 flex items-start gap-[.6rem] text-[.85rem] text-[#5d6b66] [&_input]:!w-auto [&_input]:mt-[.2rem] [&_input]:flex-[0_0_auto]">
        <input type="checkbox" name="consent" required>
        <span>I confirm the information provided is accurate and consent to Praanavaidya storing it for recruitment purposes.</span>
      </label>
      <span class="pv-error -mt-[.15rem] hidden text-[.78rem] font-semibold text-[#c0392b] [&.show]:block" id="err_consent"></span>

      <button type="submit" class="pv-submit mt-5 w-full cursor-pointer rounded-[10px] border-0 bg-brand px-6 py-[.95rem] text-[1.02rem] font-bold text-white [transition:background_.15s,transform_.05s] hover:bg-[#047fa7] active:translate-y-px disabled:cursor-not-allowed disabled:opacity-[.65] focus-visible:[outline:3px_solid_#1f2a2e] focus-visible:outline-offset-2">Submit Application</button>

      <div id="pvFormStatus" class="pv-status mt-4 min-h-[1.2em] text-center text-[.9rem] font-semibold [&.ok]:text-[#188038] [&.err]:text-[#c0392b]" role="status"></div>

      <p class="mt-5 text-center text-[.8rem] text-[#5d6b66]">Your details are kept confidential and used only for recruitment.</p>

    </form>
  </div>


  <script is:inline>
    (function () {
      var WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbz5ox7nxDYPdTXKhvPwYzQ_KHizYsUJ0_4epYVCi_5PdxNXpjBTeNj2vBSGywlINOII/exec';

      function initPvApplicationForm() {
        var form = document.getElementById('pvApplicationForm');
        var statusEl = document.getElementById('pvFormStatus');

        if (!form) {
          console.log('PV FORM NOT FOUND');
          return;
        }

        console.log('PV FORM SCRIPT LOADED');

        /* ───────────────────────── Validators ───────────────────────── */

        var NAME_RE   = /^[A-Za-z\s.'-]{2,60}$/;
        var CITY_RE   = /^[A-Za-z\s.'-]{2,50}$/;
        var MOBILE_RE = /^[6-9][0-9]{9}$/;
        var EMAIL_RE  = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
        var HAS_DIGIT_RE = /[0-9]/;

        function setFieldError(fieldId, message) {
          var input = document.getElementById(fieldId);
          var err = document.getElementById('err_' + fieldId.replace('pv_', ''));
          if (input) input.classList.toggle('pv-invalid', !!message);
          if (err) {
            err.textContent = message || '';
            err.classList.toggle('show', !!message);
          }
        }

        function setGroupError(name, message) {
          var err = document.getElementById('err_' + name);
          if (err) {
            err.textContent = message || '';
            err.classList.toggle('show', !!message);
          }
        }

        function val(id) {
          var el = document.getElementById(id);
          return el ? String(el.value || '').trim() : '';
        }

        function validateAll() {
          var ok = true;

          // Full Name
          var fullName = val('pv_full_name');
          if (!fullName) { setFieldError('pv_full_name', 'Full name is required.'); ok = false; }
          else if (!NAME_RE.test(fullName)) { setFieldError('pv_full_name', 'Only letters and spaces are allowed.'); ok = false; }
          else setFieldError('pv_full_name', '');

          // Mobile
          var mobile = val('pv_mobile');
          if (!mobile) { setFieldError('pv_mobile', 'Mobile number is required.'); ok = false; }
          else if (!MOBILE_RE.test(mobile)) { setFieldError('pv_mobile', 'Enter a valid 10-digit mobile number.'); ok = false; }
          else setFieldError('pv_mobile', '');

          // Email
          var email = val('pv_email');
          if (!email) { setFieldError('pv_email', 'Email is required.'); ok = false; }
          else if (!EMAIL_RE.test(email)) { setFieldError('pv_email', 'Enter a valid email address.'); ok = false; }
          else setFieldError('pv_email', '');

          // Current City
          var city = val('pv_current_city');
          if (!city) { setFieldError('pv_current_city', 'Current city is required.'); ok = false; }
          else if (!CITY_RE.test(city)) { setFieldError('pv_current_city', 'Enter a valid city name.'); ok = false; }
          else setFieldError('pv_current_city', '');

          // Preferred Location
          var loc = val('pv_preferred_location');
          if (!loc) { setFieldError('pv_preferred_location', 'Please select a location.'); ok = false; }
          else setFieldError('pv_preferred_location', '');

          // Applying For
          var role = val('pv_applying_for');
          if (!role) { setFieldError('pv_applying_for', 'Please select a role.'); ok = false; }
          else setFieldError('pv_applying_for', '');

          // Total Experience
          var totalExp = val('pv_total_experience');
          if (!totalExp) { setFieldError('pv_total_experience', 'Total experience is required.'); ok = false; }
          else if (!HAS_DIGIT_RE.test(totalExp)) { setFieldError('pv_total_experience', 'Include a number, e.g. "4 years".'); ok = false; }
          else setFieldError('pv_total_experience', '');

          // Relevant Experience
          var relExp = val('pv_relevant_experience');
          if (!relExp) { setFieldError('pv_relevant_experience', 'Relevant experience is required.'); ok = false; }
          else if (!HAS_DIGIT_RE.test(relExp)) { setFieldError('pv_relevant_experience', 'Include a number, e.g. "2 years".'); ok = false; }
          else setFieldError('pv_relevant_experience', '');

          // Current Company
          var company = val('pv_current_company');
          if (!company) { setFieldError('pv_current_company', 'Current company is required.'); ok = false; }
          else setFieldError('pv_current_company', '');

          // Current Designation
          var designation = val('pv_current_designation');
          if (!designation) { setFieldError('pv_current_designation', 'Current designation is required.'); ok = false; }
          else setFieldError('pv_current_designation', '');

          // Current Salary
          var curSalary = val('pv_current_salary');
          if (!curSalary) { setFieldError('pv_current_salary', 'Current salary is required.'); ok = false; }
          else if (!HAS_DIGIT_RE.test(curSalary)) { setFieldError('pv_current_salary', 'Include a number, e.g. "4.5 LPA".'); ok = false; }
          else setFieldError('pv_current_salary', '');

          // Expected Salary
          var expSalary = val('pv_expected_salary');
          if (!expSalary) { setFieldError('pv_expected_salary', 'Expected salary is required.'); ok = false; }
          else if (!HAS_DIGIT_RE.test(expSalary)) { setFieldError('pv_expected_salary', 'Include a number, e.g. "6 LPA".'); ok = false; }
          else setFieldError('pv_expected_salary', '');

          // Languages
          var languages = val('pv_languages');
          if (!languages) { setFieldError('pv_languages', 'Languages known is required.'); ok = false; }
          else setFieldError('pv_languages', '');

          // Qualification
          var qualification = val('pv_qualification');
          if (!qualification) { setFieldError('pv_qualification', 'Educational qualification is required.'); ok = false; }
          else setFieldError('pv_qualification', '');

          // Relocate (radio group)
          if (!getRadioValue('relocate')) { setGroupError('relocate', 'Please select an option.'); ok = false; }
          else setGroupError('relocate', '');

          // Interview mode (radio group)
          if (!getRadioValue('interview_mode')) { setGroupError('interview_mode', 'Please select an option.'); ok = false; }
          else setGroupError('interview_mode', '');

          // Interview Date — must not be in the past
          var interviewDate = val('pv_interview_date');
          if (!interviewDate) {
            setFieldError('pv_interview_date', 'Please select a date.');
            ok = false;
          } else {
            var chosen = new Date(interviewDate + 'T00:00:00');
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            if (chosen < today) {
              setFieldError('pv_interview_date', 'Date cannot be in the past.');
              ok = false;
            } else {
              setFieldError('pv_interview_date', '');
            }
          }

          // Consent
          var consent = form.elements['consent'] && form.elements['consent'].checked;
          if (!consent) { setGroupError('consent', 'You must confirm and consent to proceed.'); ok = false; }
          else setGroupError('consent', '');

          return ok;
        }

        // live validation as the user types/selects
        ['pv_full_name', 'pv_mobile', 'pv_email', 'pv_current_city', 'pv_preferred_location',
         'pv_applying_for', 'pv_total_experience', 'pv_relevant_experience', 'pv_current_company',
         'pv_current_designation', 'pv_current_salary', 'pv_expected_salary', 'pv_languages',
         'pv_qualification', 'pv_interview_date'].forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          var evt = el.tagName === 'SELECT' ? 'change' : 'input';
          el.addEventListener(evt, validateAll);
        });

        // mobile: block non-digit keystrokes, cap at 10 chars
        document.getElementById('pv_mobile').addEventListener('input', function (e) {
          e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10);
        });

        function setStatus(message, type) {
          if (!statusEl) return;

          statusEl.textContent = message || '';
          statusEl.className = 'pv-status';

          if (type) {
            statusEl.classList.add(type);
          }
        }

        function getValue(name) {
          var field = form.elements[name];
          return field ? String(field.value || '').trim() : '';
        }

        function getRadioValue(name) {
          var checked = form.querySelector('input[name="' + name + '"]:checked');
          return checked ? checked.value : '';
        }

        function validateFile(file, fieldName, allowedExtensions, errId) {
          if (!file) {
            setFieldError2(errId, fieldName + ' is required.');
            throw new Error(fieldName + ' is required.');
          }

          var maxSizeMB = 10;
          var maxSizeBytes = maxSizeMB * 1024 * 1024;

          if (file.size > maxSizeBytes) {
            setFieldError2(errId, fieldName + ' should not exceed ' + maxSizeMB + ' MB.');
            throw new Error(fieldName + ' should not exceed ' + maxSizeMB + ' MB.');
          }

          var fileName = String(file.name || '').toLowerCase();

          var allowed = allowedExtensions.some(function (ext) {
            return fileName.endsWith(ext);
          });

          if (!allowed) {
            setFieldError2(errId, 'Invalid file type for ' + fieldName + '.');
            throw new Error('Invalid file type for ' + fieldName + '.');
          }

          setFieldError2(errId, '');
        }

        function setFieldError2(errId, message) {
          var err = document.getElementById(errId);
          if (err) {
            err.textContent = message || '';
            err.classList.toggle('show', !!message);
          }
        }

        function fileToBase64(file) {
          return new Promise(function (resolve, reject) {
            if (!file) {
              resolve(null);
              return;
            }

            var reader = new FileReader();

            reader.onload = function () {
              var result = String(reader.result || '');
              var base64 = result.split(',')[1];

              resolve({
                name: file.name,
                type: file.type || 'application/octet-stream',
                data: base64
              });
            };

            reader.onerror = function () {
              reject(new Error('Unable to read file: ' + file.name));
            };

            reader.readAsDataURL(file);
          });
        }

        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          e.stopPropagation();

          console.log('PV FORM SUBMIT TRIGGERED');

          setStatus('', '');

          if (!WEB_APP_URL || WEB_APP_URL.indexOf('/exec') === -1) {
            alert('Apps Script /exec URL is missing or incorrect.');
            return false;
          }

          var hp = form.querySelector('input[name="website"]');

          if (hp && hp.value.trim() !== '') {
            return false;
          }

          // custom validation (runs before native checkValidity)
          var customOk = validateAll();

          if (!customOk) {
            setStatus('Please fix the highlighted fields.', 'err');
            var firstInvalid = form.querySelector('.pv-invalid');
            if (firstInvalid) firstInvalid.focus();
            return false;
          }

          if (!form.checkValidity()) {
            form.reportValidity();
            return false;
          }

          var submitBtn = form.querySelector('.pv-submit');
          var originalText = submitBtn ? submitBtn.textContent : 'Submit Application';

          try {
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = 'Submitting...';
            }

            setStatus('Submitting your application...', '');

            var resumeInput = document.getElementById('pv_resume');
            var photoInput = document.getElementById('pv_photo');

            var resumeFile = resumeInput && resumeInput.files ? resumeInput.files[0] : null;
            var photoFile = photoInput && photoInput.files ? photoInput.files[0] : null;

            validateFile(resumeFile, 'Resume', ['.pdf', '.doc', '.docx', '.jpg', '.jpeg'], 'err_resume');
            validateFile(photoFile, 'Photograph', ['.jpg', '.jpeg', '.png'], 'err_photo');

            var payload = {
              website: getValue('website'),

              full_name: getValue('full_name'),
              mobile: getValue('mobile'),
              email: getValue('email'),
              current_city: getValue('current_city'),
              preferred_location: getValue('preferred_location'),
              applying_for: getValue('applying_for'),

              total_experience: getValue('total_experience'),
              relevant_experience: getValue('relevant_experience'),
              current_company: getValue('current_company'),
              current_designation: getValue('current_designation'),
              current_salary: getValue('current_salary'),
              expected_salary: getValue('expected_salary'),
              languages: getValue('languages'),
              qualification: getValue('qualification'),

              relocate: getRadioValue('relocate'),
              interview_mode: getRadioValue('interview_mode'),
              interview_date: getValue('interview_date'),

              consent: form.elements['consent'].checked ? 'Yes' : '',

              resume: await fileToBase64(resumeFile),
              photo: await fileToBase64(photoFile)
            };

            var params = new URLSearchParams();
            params.append('payload', JSON.stringify(payload));

            console.log('Sending to Apps Script:', WEB_APP_URL);

            await fetch(WEB_APP_URL, {
              method: 'POST',
              mode: 'no-cors',
              body: params
            });

            console.log('Apps Script request sent');

            setStatus('Application submitted successfully.', 'ok');
            alert('Application submitted successfully.');

            form.reset();
            document.querySelectorAll('.pv-error').forEach(function (el) { el.classList.remove('show'); });
            document.querySelectorAll('.pv-invalid').forEach(function (el) { el.classList.remove('pv-invalid'); });

          } catch (error) {
            console.error(error);

            setStatus(error.message || 'Something went wrong. Please try again.', 'err');
            alert(error.message || 'Something went wrong. Please try again.');

          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
            }
          }

          return false;
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPvApplicationForm);
      } else {
        initPvApplicationForm();
      }
    })();
  </script>

<p class="wp-block-paragraph"></p>
		</div>

	</article>

			</div>

