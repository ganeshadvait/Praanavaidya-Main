/* -----------------------------------------
   Render FAQ
------------------------------------------ */
function pv_renderFAQ() {
    const container = document.getElementById("pv-faq-container");
    
    // Combine all categories into one array
    const allFaqs = [
        ...pv_faqData.general
//         ...pv_faqData.features,
//         ...pv_faqData.resources
    ];
    
    container.innerHTML = allFaqs.map((faq, i) => `
        <div class="border-b border-[#EEEEEE] px-[10px] pb-[32px] pt-[22px] max-[768px]:!pb-[20px] max-[768px]:!pt-[15px]">
            <button class="pv-faq-question flex w-full cursor-pointer items-center justify-between border-none bg-transparent bg-none p-0 text-left text-[20px] font-semibold text-[#111] [transition:color_0.2s_ease] [&.active]:text-brand ${i === 0 ? 'active' : ''}" onclick="pv_toggleFAQ(${i})">
               <span class="flex flex-1 items-center gap-3">
					<span>${faq.q}</span>
			   </span>
                <span class="pv-faq-toggle shrink-0 text-[28px] font-semibold leading-none text-[#999] [transition:color_0.2s_ease] [&.active]:text-brand ${i === 0 ? 'active' : ''}" id="pv-icon-${i}">${i === 0 ? '−' : '+'}</span>
            </button>
            <div class="pv-faq-answer max-h-0 mt-0 overflow-hidden text-[16px] leading-[1.7] text-[#6F6C8F] [transition:max-height_0.3s_ease] [&.open]:mt-4 ${i === 0 ? 'open' : ''}" id="pv-answer-${i}" style="max-height: ${i === 0 ? '500px' : '0px'}">
                ${faq.a}
            </div>
        </div>
    `).join('');
}

/* -----------------------------------------
   Toggle FAQ
------------------------------------------ */
function pv_toggleFAQ(i) {
    const container = document.getElementById("pv-faq-container");
    const answers = container.querySelectorAll(".pv-faq-answer");
    const icons = container.querySelectorAll(".pv-faq-toggle");
    const questions = container.querySelectorAll(".pv-faq-question");
    
    answers.forEach((ans, idx) => {
        if (idx === i) {
            const isOpen = ans.classList.contains('open');
            
            if (isOpen) {
                ans.style.maxHeight = "0px";
                ans.classList.remove('open');
                icons[idx].textContent = "+";
                icons[idx].classList.remove('active');
                questions[idx].classList.remove('active');
            } else {
                ans.style.maxHeight = ans.scrollHeight + "px";
                ans.classList.add('open');
                icons[idx].textContent = "−";
                icons[idx].classList.add('active');
                questions[idx].classList.add('active');
            }
        } else {
            ans.style.maxHeight = "0px";
            ans.classList.remove('open');
            icons[idx].textContent = "+";
            icons[idx].classList.remove('active');
            questions[idx].classList.remove('active');
        }
    });
}

// Initialize on page load
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pv_renderFAQ);
} else {
    pv_renderFAQ();
}
