<script is:inline>
(function() {
  const id = "ther_23aa0e";
  const carousel = document.getElementById("pv-carousel-" + id);
  const itemsHost = document.getElementById("pv-items-" + id);

  if (!carousel || !itemsHost) return;

  const originalItems = Array.from(itemsHost.children).map(node => node.cloneNode(true));

  let currentPerSlide = null;
  let autoSlideInterval;
  let isHovered = false;

  function getPerSlide() {
    return window.matchMedia("(max-width: 768px)").matches ? 4 : 6;
  }

  function buildSlides(perSlide) {
    Array.from(carousel.children).forEach(child => {
      if (child !== itemsHost) child.remove();
    });

    let slides = [];

    for (let i = 0; i < originalItems.length; i += perSlide) {
      const slide = document.createElement("div");
      slide.className = "pv-slide grid min-w-full snap-start gap-6 p-4 min-[769px]:grid-cols-3 max-[768px]:grid-cols-1 min-[769px]:auto-rows-[1fr] max-[768px]:auto-rows-auto";

      const chunk = originalItems.slice(i, i + perSlide);
      chunk.forEach(card => slide.appendChild(card.cloneNode(true)));

      slides.push(slide);
    }

    // 🔥 CLONE FOR INFINITE LOOP
    slides.forEach(s => carousel.appendChild(s.cloneNode(true)));
    slides.forEach(s => carousel.appendChild(s));

    carousel.scrollLeft = carousel.scrollWidth / 2; // start from middle
  }

  function applyLayout() {
    const perSlide = getPerSlide();
    if (perSlide === currentPerSlide) return;
    currentPerSlide = perSlide;
    buildSlides(perSlide);
  }

  function autoSlide() {
    if (isHovered) return;

    const slide = carousel.querySelector(".pv-slide");
    if (!slide) return;

    const slideWidth = slide.getBoundingClientRect().width;

    carousel.scrollBy({ left: slideWidth, behavior: "smooth" });
  }

  function startAutoSlide() {
    stopAutoSlide();
    autoSlideInterval = setInterval(autoSlide, 3000); // speed here
  }

  function stopAutoSlide() {
    clearInterval(autoSlideInterval);
  }

  // 🔁 Infinite loop correction
  carousel.addEventListener("scroll", () => {
    const maxScroll = carousel.scrollWidth;
    const current = carousel.scrollLeft;

    if (current <= 0) {
      carousel.scrollLeft = maxScroll / 2;
    } else if (current >= maxScroll - carousel.clientWidth) {
      carousel.scrollLeft = maxScroll / 2;
    }
  });

  // Pause on hover
  carousel.addEventListener("mouseenter", () => {
    isHovered = true;
  });

  carousel.addEventListener("mouseleave", () => {
    isHovered = false;
  });

  // Arrows (keep same)
  window.pvScrollTherapies = function(idArg, dir) {
    const c = document.getElementById("pv-carousel-" + idArg);
    if (!c) return;

    const slide = c.querySelector(".pv-slide");
    const slideWidth = slide ? slide.getBoundingClientRect().width : c.clientWidth;

    c.scrollBy({ left: dir * slideWidth, behavior: "smooth" });
  };

  // Resize handling
  let resizeTimer = null;
  function onResize() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      applyLayout();
      startAutoSlide();
    }, 150);
  }

  // INIT
  applyLayout();
  startAutoSlide();

  window.addEventListener("resize", onResize);
})();
</script>

