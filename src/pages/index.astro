<!-- Carousel JS -->
<script is:inline>
(function () {
    const carousel = document.getElementById('pvServicesCarousel');
    const next = document.getElementById('pvNext');
    const prev = document.getElementById('pvPrev');

    if (!carousel) return;

    const cardWidth = carousel.querySelector('div').offsetWidth + 24;

    next.addEventListener('click', () => {
        carousel.scrollLeft += cardWidth;
    });

    prev.addEventListener('click', () => {
        carousel.scrollLeft -= cardWidth;
    });
})();
</script>


