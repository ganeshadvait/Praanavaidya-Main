<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
    
    // Desktop Tab Switching
    const tabs = document.querySelectorAll('.city-tab');
    const contents = document.querySelectorAll('.city-content');
    
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const city = this.getAttribute('data-city');
            
            // Update tab styles
            tabs.forEach(t => {
                t.classList.remove('bg-[#0595C4]', 'text-white');
                t.classList.add('text-[#555]');
            });
            this.classList.add('bg-[#0595C4]', 'text-white');
            this.classList.remove('text-[#555]');
            
            // Show selected content
            contents.forEach(content => {
                if (content.getAttribute('data-city') === city) {
                    content.classList.remove('hidden');
                } else {
                    content.classList.add('hidden');
                }
            });
        });
    });
    
    // Mobile Select Dropdown
    const mobileSelect = document.getElementById('citySelectMobile');
    if (mobileSelect) {
        mobileSelect.addEventListener('change', function() {
            const city = this.value;
            
            contents.forEach(content => {
                if (content.getAttribute('data-city') === city) {
                    content.classList.remove('hidden');
                } else {
                    content.classList.add('hidden');
                }
            });
        });
    }
    
    // Mobile Carousel Dots
    const carousels = document.querySelectorAll('.city-content > div.flex.overflow-x-auto');
    
    carousels.forEach(carousel => {
        const dots = carousel.nextElementSibling?.querySelectorAll('.mobile-dot');
        if (!dots) return;
        
        carousel.addEventListener('scroll', function() {
            const scrollLeft = carousel.scrollLeft;
            const cardWidth = carousel.querySelector('div').offsetWidth + 16; // width + gap
            const activeIndex = Math.round(scrollLeft / cardWidth);
            
            dots.forEach((dot, index) => {
                if (index === activeIndex) {
                    dot.classList.add('bg-[#0595C4]');
                    dot.classList.remove('bg-gray-300');
                } else {
                    dot.classList.remove('bg-[#0595C4]');
                    dot.classList.add('bg-gray-300');
                }
            });
        });
    });
});
</script>


