<script is:inline>
(function () {

  /* ── FAQ accordion ── */
  document.querySelectorAll('.cp-faq-q').forEach(function (q) {
    q.addEventListener('click', function () {
      var item    = q.parentElement;
      var wasOpen = item.classList.contains('open');
      document.querySelectorAll('.cp-faq-item').forEach(function (i) {
        i.classList.remove('open');
        i.querySelector('.x').textContent = '+';
      });
      if (!wasOpen) {
        item.classList.add('open');
        item.querySelector('.x').textContent = '×';
      }
    });
  });

  /* ── Job filter ── */
  var tabs      = document.querySelectorAll('.cp-tab');
  var jobCards  = document.querySelectorAll('.cp-job-card');
  var locFilter = document.getElementById('cpLocFilter');
  var noResults = document.getElementById('cpNoResults');

  function applyFilters() {
    var activeCat = document.querySelector('.cp-tab.active').dataset.filter;
    var activeLoc = locFilter ? locFilter.value : 'all';
    var visible   = 0;
    jobCards.forEach(function (card) {
      var show = (activeCat === 'all' || card.dataset.cat === activeCat)
              && (activeLoc === 'all' || card.dataset.loc === activeLoc);
      card.style.display = show ? 'flex' : 'none';
      if (show) visible++;
    });
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.remove('active'); });
      tab.classList.add('active');
      applyFilters();
    });
  });
  if (locFilter) locFilter.addEventListener('change', applyFilters);

  /* ── Apply Now scroll ── */
  window.cpGoApply = function (roleTitle) {
    var applySection = document.getElementById('cp-apply');
    if (applySection) applySection.scrollIntoView({ behavior: 'smooth' });
  };

})();
</script>

